# Server Environment
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Frontend Web Origin (CORS & Cookie handling)
WEB_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL - Neon / Supabase or Local Docker)
# Example Cloud (Neon/Supabase): postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# Example Local: postgresql://fieldops:fieldops_dev_pass@localhost:5432/fieldops?schema=public
DATABASE_URL=postgresql://fieldops:fieldops_dev_pass@localhost:5432/fieldops?schema=public

# Session Secret (min 32 characters for HMAC SHA-256 session signing)
SESSION_SECRET=change_this_to_a_secure_long_random_session_secret_at_least_32_chars

# Storage configuration (local / s3)
UPLOAD_STORAGE=local
UPLOAD_DIR=./uploads

# Log Level
LOG_LEVEL=debug

